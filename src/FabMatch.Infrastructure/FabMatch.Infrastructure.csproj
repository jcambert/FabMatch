<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
		<DotNetVersionPattern>10.*</DotNetVersionPattern>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FabMatch.Infrastructure</RootNamespace>
    <AssemblyName>FabMatch.Infrastructure</AssemblyName>
    <Description>FabMatch Infrastructure Layer - EF Core, repositories, external service implementations</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FabMatch.Domain\FabMatch.Domain.csproj" />
    <ProjectReference Include="..\FabMatch.Application\FabMatch.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

    <!-- ASP.NET Core Identity + EF Core stores -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />

    <!-- OpenAI .NET SDK (official) -->
    <PackageReference Include="OpenAI" Version="2.9.1" />

    <!-- Stripe .NET SDK for payments -->
    <PackageReference Include="Stripe.net" Version="50.4.1" />

    <!-- PDF to image conversion -->
    <PackageReference Include="PDFtoImage" Version="5.2.0" />

    <!-- Serilog -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />

    <!-- Microsoft DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />

    <!-- SignalR (server-side) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.9" />

    <!-- MailKit for SMTP email sending -->
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="MimeKit" Version="4.15.1" />

    <!-- QRCode for TOTP setup -->
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

</Project>
