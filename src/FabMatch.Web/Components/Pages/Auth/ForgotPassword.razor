@page "/auth/forgot-password"
@using FabMatch.Application.Common.Interfaces
@using FabMatch.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Forgot Password – FabMatch</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5">
        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Align="Align.Center">Reset your password</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Enter your email address and we'll send you a reset link.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_sent)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">
                        If an account with that email exists, a password reset link has been sent.
                        Please check your inbox.
                    </MudAlert>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                        <DataAnnotationsValidator />

                        <MudTextField @bind-Value="_model.Email"
                                      Label="Email address"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Class="mb-4" />

                        <ValidationMessage For="() => _model.Email" />

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="_loading">
                            @if (_loading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Send Reset Link
                        </MudButton>
                    </EditForm>
                }
            </MudCardContent>
            <MudCardActions Class="justify-center pb-4">
                <MudLink Href="/auth/login" Typo="Typo.body2">Back to Sign In</MudLink>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private readonly ForgotPasswordModel _model = new();
    private bool _loading;
    private bool _sent;

    private async Task HandleSubmitAsync()
    {
        _loading = true;
        try
        {
            var user = await UserManager.FindByEmailAsync(_model.Email);

            // Always respond with success to prevent email enumeration attacks.
            if (user is not null && await UserManager.IsEmailConfirmedAsync(user) == false ||
                user is not null)
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user!);
                var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
                var resetUrl = Nav.ToAbsoluteUri(
                    $"/auth/reset-password?userId={user!.Id}&token={encodedToken}").ToString();

                await EmailService.SendPasswordResetAsync(
                    user.Email!,
                    user.FullName,
                    resetUrl);
            }

            _sent = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
