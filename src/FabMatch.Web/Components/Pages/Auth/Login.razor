@page "/auth/login"

<PageTitle>Sign In – FabMatch</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center">Sign In to FabMatch</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                    The industrial matchmaking platform
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (Error == "invalid")
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Invalid email or password.
                </MudAlert>
            }
            else if (Error == "locked")
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Account is locked. Try again later.
                </MudAlert>
            }

            <form method="post" action="/auth/login/execute">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-3">
                    <label for="email" class="mud-typography mud-typography-body2">Email Address</label>
                    <input id="email" name="email" type="email" value="@Email" required class="mud-input-slot mud-input-root mud-input-root-filled" style="width:100%;padding:10px 12px;border:1px solid rgba(0,0,0,.23);border-radius:4px;" />
                </div>

                <div class="mb-3">
                    <label for="password" class="mud-typography mud-typography-body2">Password</label>
                    <input id="password" name="password" type="password" required class="mud-input-slot mud-input-root mud-input-root-filled" style="width:100%;padding:10px 12px;border:1px solid rgba(0,0,0,.23);border-radius:4px;" />
                </div>

                <div class="mb-2">
                    <input type="hidden" name="rememberMe" value="false" />
                    <input id="rememberMe" name="rememberMe" type="checkbox" value="true" />
                    <label for="rememberMe" class="mud-typography mud-typography-body2 ml-1">Remember me</label>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-4">
                    Sign In
                </MudButton>
            </form>
        </MudCardContent>
        <MudCardActions Class="pa-4 d-flex flex-column">
            <MudLink Href="/auth/register" Class="mb-2">Don't have an account? Register</MudLink>
            <MudLink Href="/auth/forgot-password">Forgot your password?</MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Email { get; set; }
}
