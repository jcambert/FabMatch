@page "/auth/reset-password"
@using FabMatch.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Reset Password – FabMatch</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5">
        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Align="Align.Center">Set new password</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_invalidLink)
                {
                    <MudAlert Severity="Severity.Error">
                        This reset link is invalid or has expired.
                        <MudLink Href="/auth/forgot-password">Request a new one.</MudLink>
                    </MudAlert>
                }
                else if (_success)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">
                        Your password has been reset successfully.
                    </MudAlert>
                    <MudButton Href="/auth/login" Variant="Variant.Filled"
                               Color="Color.Primary" FullWidth="true">
                        Sign In
                    </MudButton>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                        <DataAnnotationsValidator />

                        <MudTextField @bind-Value="_model.NewPassword"
                                      Label="New Password"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      Class="mb-3" />

                        <MudTextField @bind-Value="_model.ConfirmPassword"
                                      Label="Confirm Password"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      Class="mb-4" />

                        @if (_errors.Count > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">
                                @foreach (var err in _errors)
                                {
                                    <div>@err</div>
                                }
                            </MudAlert>
                        }

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="_loading">
                            @if (_loading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Reset Password
                        </MudButton>
                    </EditForm>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private readonly ResetPasswordModel _model = new();
    private bool _loading;
    private bool _success;
    private bool _invalidLink;
    private readonly List<string> _errors = [];

    private string? _userId;
    private string? _token;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("userId", out var userId) ||
            !query.TryGetValue("token", out var token))
        {
            _invalidLink = true;
            return;
        }

        _userId = userId;
        _token = token;
    }

    private async Task HandleSubmitAsync()
    {
        _errors.Clear();

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errors.Add("Passwords do not match.");
            return;
        }

        if (string.IsNullOrEmpty(_userId) || string.IsNullOrEmpty(_token))
        {
            _invalidLink = true;
            return;
        }

        _loading = true;
        try
        {
            var user = await UserManager.FindByIdAsync(_userId);
            if (user is null)
            {
                _invalidLink = true;
                return;
            }

            // Decode the token from URL-safe Base64
            var decodedToken = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(_token));
            var result = await UserManager.ResetPasswordAsync(user, decodedToken, _model.NewPassword);

            if (result.Succeeded)
            {
                _success = true;
            }
            else
            {
                foreach (var error in result.Errors)
                    _errors.Add(error.Description);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
