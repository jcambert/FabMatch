@page "/clients"
@attribute [Authorize(Roles = "Supplier")]
@using FabMatch.Domain.Entities
@using FabMatch.Domain.Interfaces
@inject IUnitOfWork Uow

<PageTitle>Browse Clients – FabMatch</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Browse Clients</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@_clients.Count client(s) found</MudText>
</MudStack>

<MudTextField @bind-Value="_search"
              Placeholder="Search by company name, industry or description…"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              DebounceInterval="350"
              OnDebounceIntervalElapsed="SearchAsync"
              Clearable="true"
              OnClearButtonClick="ClearAsync"
              Class="mb-4"
              Style="max-width:520px" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_clients.Count == 0 && !_loading)
{
    <MudAlert Severity="Severity.Info">No clients match your search.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var client in _clients)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary">
                                @client.CompanyName.FirstOrDefault()
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@client.CompanyName</MudText>
                            @if (!string.IsNullOrEmpty(client.Industry))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@client.Industry</MudChip>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!string.IsNullOrEmpty(client.WebsiteUrl))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                               Href="@client.WebsiteUrl" Target="_blank"
                                               Title="Visit website" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (!string.IsNullOrEmpty(client.Description))
                        {
                            <MudText Typo="Typo.body2">
                                @(client.Description.Length > 140
                                    ? client.Description[..140] + "…"
                                    : client.Description)
                            </MudText>
                        }
                        @if (!string.IsNullOrEmpty(client.CompanySize))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small"
                                         Color="Color.Secondary" />
                                <MudText Typo="Typo.caption">@client.CompanySize employees</MudText>
                            </MudStack>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Size="Size.Small"
                                   Href="@($"/clients/{client.Id}/projects")"
                                   StartIcon="@Icons.Material.Filled.Folder">
                            View Projects
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (_hasMore)
    {
        <div class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="LoadMoreAsync" Disabled="_loading">
                Load More
            </MudButton>
        </div>
    }
}

@code {
    private bool _loading = true;
    private string _search = "";
    private List<Client> _clients = [];
    private bool _hasMore;
    private int _skip;
    private const int PageSize = 18;

    protected override async Task OnInitializedAsync()
        => await SearchAsync();

    private async Task SearchAsync()
    {
        _loading = true;
        _skip = 0;
        var results = await Uow.Clients.SearchAsync(_search ?? "", 0, PageSize + 1);
        _hasMore = results.Count > PageSize;
        _clients = results.Take(PageSize).ToList();
        _loading = false;
    }

    private async Task ClearAsync()
    {
        _search = "";
        await SearchAsync();
    }

    private async Task LoadMoreAsync()
    {
        _loading = true;
        _skip += PageSize;
        var results = await Uow.Clients.SearchAsync(_search ?? "", _skip, PageSize + 1);
        _hasMore = results.Count > PageSize;
        _clients.AddRange(results.Take(PageSize));
        _loading = false;
    }
}
