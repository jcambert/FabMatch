@page "/suppliers"
@attribute [Authorize]
@using FabMatch.Application.Features.Suppliers.Queries.SearchSuppliers
@inject IMediator Mediator

<PageTitle>Find Suppliers – FabMatch</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Find Suppliers</MudText>

<!-- Filters panel -->
<MudExpansionPanels Class="mb-4" Elevation="2">
    <MudExpansionPanel Text="Search & Filters" Icon="@Icons.Material.Filled.FilterList"
                       Expanded="true">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_searchTerm" Label="Keyword search"
                              Placeholder="Company name, process…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="400"
                              OnDebounceIntervalElapsed="SearchAsync" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_country" Label="Country"
                              Placeholder="e.g. France, Germany…" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_processInput"
                              Label="Required Processes (comma-separated)"
                              HelperText="e.g. Laser Cutting,Bending" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-3" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="SearchAsync" StartIcon="@Icons.Material.Filled.Search">
                Search
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear</MudButton>
        </MudStack>
    </MudExpansionPanel>
</MudExpansionPanels>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_results.Count == 0)
{
    <MudAlert Severity="Severity.Info">No suppliers found matching your criteria.</MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-3">@_results.Count result(s)</MudText>
    <MudGrid>
        @foreach (var s in _results)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@s.CompanyName</MudText>
                            <MudText Typo="Typo.caption">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                                         Size="Size.Small" Class="mr-1" />@s.Country
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (s.HasEmbedding)
                            {
                                <MudTooltip Text="AI embedding ready – eligible for matching">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                                             Color="Color.Success" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            @(s.Presentation.Length > 120
                                ? s.Presentation[..120] + "…"
                                : s.Presentation)
                        </MudText>

                        @if (s.Materials.Count > 0)
                        {
                            <div class="mb-2">
                                @foreach (var m in s.Materials.Take(3))
                                {
                                    <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1">@m</MudChip>
                                }
                                @if (s.Materials.Count > 3)
                                {
                                    <MudChip T="string" Size="Size.Small">+@(s.Materials.Count - 3)</MudChip>
                                }
                            </div>
                        }

                        <MudText Typo="Typo.caption">
                            @s.CapabilityCount process capability(ies) ·
                            @s.Certifications.Count certification(s)
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="@($"/suppliers/{s.Id}")" Size="Size.Small">View Profile</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <!-- Pagination -->
    <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
        <MudButton Disabled="_skip == 0" OnClick="PrevPage"
                   StartIcon="@Icons.Material.Filled.ArrowBack">Previous</MudButton>
        <MudText Class="mx-4 align-self-center">Page @(_skip / _take + 1)</MudText>
        <MudButton Disabled="_results.Count < _take" OnClick="NextPage"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Next</MudButton>
    </MudStack>
}

@code {
    private string _searchTerm = "";
    private string _country = "";
    private string _processInput = "";
    private bool _loading = true;
    private int _skip, _take = 12;
    private List<SupplierSearchResultDto> _results = [];

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        _loading = true;
        var processes = _processInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        _results = (await Mediator.Send(new SearchSuppliersQuery(
            string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            processes.Length > 0 ? processes : null,
            null,
            string.IsNullOrWhiteSpace(_country) ? null : _country,
            _skip, _take))).ToList();

        _loading = false;
    }

    private void ClearFilters()
    {
        _searchTerm = _country = _processInput = "";
        _skip = 0;
        _ = SearchAsync();
    }

    private async Task PrevPage() { _skip = Math.Max(0, _skip - _take); await SearchAsync(); }
    private async Task NextPage() { _skip += _take; await SearchAsync(); }
}
