@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Components.Layout.MainLayout)">
            <NotAuthorized>
                @if (!context.User.Identity!.IsAuthenticated)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <MudBlazor.MudText Typo="MudBlazor.Typo.h5" Class="pa-4">
                        You do not have permission to access this page.
                    </MudBlazor.MudText>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <LayoutView Layout="typeof(Components.Layout.MainLayout)">
            <MudBlazor.MudText Typo="MudBlazor.Typo.h4">Page not found (404).</MudBlazor.MudText>
        </LayoutView>
    </NotFound>
</Router>
