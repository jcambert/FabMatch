<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>FabMatch.Tests</RootNamespace>
    <Description>FabMatch Unit and Integration Tests</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FabMatch.Domain\FabMatch.Domain.csproj" />
    <ProjectReference Include="..\..\src\FabMatch.Application\FabMatch.Application.csproj" />
    <ProjectReference Include="..\..\src\FabMatch.Infrastructure\FabMatch.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit testing framework -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />

    <!-- Moq for mocking -->
    <PackageReference Include="Moq" Version="4.20.72" />

    <!-- FluentAssertions for readable assertions -->
    <PackageReference Include="FluentAssertions" Version="7.0.0" />

    <!-- Serilog for test logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.XUnit" Version="3.0.5" />

    <!-- EF Core InMemory for tests -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />

    <!-- Testcontainers for PostgreSQL integration tests -->
    <PackageReference Include="Testcontainers" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.3.0" />

    <!-- Microsoft DI for test setup -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
